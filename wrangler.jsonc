{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maison-sillon",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-11",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_YOUR_D1_NAME",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
